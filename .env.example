# ---- apps/web (Vercel) ----
ANTHROPIC_API_KEY=
DATABASE_URL=postgres://user:pass@host:port/db
BLOB_READ_WRITE_TOKEN=
MERCHANT_PIN=1234
MERCHANT_TAX_RATE=0.06625
PAYMENT_PROGRAM=none   # none | surcharge | cash_discount

# ---- apps/worker (Railway) ----
# DATABASE_URL and BLOB_READ_WRITE_TOKEN as above
CLOVER_EMAIL=
CLOVER_PASSWORD=
CLOVER_LOGIN_URL=https://www.clover.com/login
DATA_DIR=/data
DRY_RUN=true
MERCHANT_TAX_RATE=0.06625   # worker uses it to pick the right tax checkbox
RECON=false
POLL_INTERVAL_MS=5000
