# Everything runs on Railway: one project, three services (Postgres, worker, web).

# ---- worker service ----
DATABASE_URL=${{Postgres.DATABASE_URL}}
RAILWAY_DOCKERFILE_PATH=apps/worker/Dockerfile
DATA_DIR=/data                # volume mounted here keeps the Clover login
CLOVER_EMAIL=                 # set by Jon
CLOVER_PASSWORD=              # set by Jon
MERCHANT_TAX_RATE=0.06625     # picks the right tax checkbox
DRY_RUN=true                  # true = fill but never click Send
RECON=false                   # true = one-time scouting run of the Clover form

# ---- web service ----
DATABASE_URL=${{Postgres.DATABASE_URL}}
RAILWAY_DOCKERFILE_PATH=apps/web/Dockerfile
ANTHROPIC_API_KEY=            # set by Jon
MERCHANT_PIN=                 # set by Jon
MERCHANT_TAX_RATE=0.06625
BUSINESS_NAME="M&J Painting and Reno"   # shown on the estimate preview
DEFAULT_DEPOSIT_PERCENT=50   # standard terms the assistant uses unless told otherwise
DEFAULT_VALID_DAYS=29   # Clover rejects expirations 30+ days out
DEFAULT_TAXABLE=true
PAYMENT_PROGRAM=cash_discount # none | surcharge | cash_discount
